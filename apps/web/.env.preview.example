# Minimum env vars for a working Vercel preview deploy (no Tinybird, no Stripe).
# Paste these into Vercel → Project → Settings → Environment Variables.
#
# Marketplace integrations (install from Vercel → Storage / Integrations) inject
# the following automatically — do NOT set them manually:
#   PlanetScale  → DATABASE_URL
#   Upstash KV   → UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN
#   Upstash QStash → QSTASH_TOKEN, QSTASH_CURRENT_SIGNING_KEY, QSTASH_NEXT_SIGNING_KEY

# --- App identity --------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Dub
# Set both of these to the Vercel preview/production hostname (no protocol).
NEXT_PUBLIC_APP_DOMAIN=your-fork.vercel.app
NEXT_PUBLIC_APP_SHORT_DOMAIN=your-fork.vercel.app

# --- Secrets (generate fresh per env) -----------------------------------------
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
CRON_SECRET=
ENCRYPTION_KEY=

# --- Tinybird (stubbed — analytics will no-op, redirects still work) ----------
TINYBIRD_API_KEY=stub
TINYBIRD_API_URL=https://api.tinybird.co

# --- Auth provider (pick ONE) -------------------------------------------------
# Option A: Email magic-link via Resend
# RESEND_API_KEY=
#
# Option B: GitHub OAuth (easier for e2e — no email infra)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
